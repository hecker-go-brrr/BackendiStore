// ============================================================
// Chennai Math iStore Assistant — SalesIQ Script Zobot
// Handler: Message Handler
// ============================================================
// Paste this into: Settings > Bot > Zobot > [your bot] > Message Handler
//
// BEFORE PUBLISHING:
//   Replace YOUR_RENDER_URL below with your actual Render service URL,
//   e.g. https://istore-rkm-backend.onrender.com
// ============================================================

response = Map();

if(operation.equals("chat") || operation.equals("message"))
{
	msg = message.get("text");
	visitorId = visitor.get("id");

	// ---------------------------------------------------------------
	// PHASE 2 (once Zoho Commerce access + Connection are set up):
	// Fetch product data here BEFORE calling the backend, then include
	// it in the payload below as "product_data". Example:
	//
	// productData = invokeUrl
	// [
	//     url: "https://commerce.zoho.in/store/api/v1/products"
	//     type: GET
	//     connection: "zoho_commerce_conn"
	// ];
	// payload.put("product_data", productData.get("products"));
	// ---------------------------------------------------------------

	payload = Map();
	payload.put("message", msg);
	payload.put("visitor_id", visitorId);

	headers = Map();
	headers.put("Content-Type", "application/json");

	reply = "Sorry, I'm having trouble reaching my brain right now — a team member will be with you shortly.";

	try
	{
		backendResponse = invokeUrl
		[
			url: "https://YOUR_RENDER_URL.onrender.com/chat"
			type: POST
			parameters: payload.toString()
			headers: headers
		];

		if(backendResponse != null && backendResponse.get("reply") != null)
		{
			reply = backendResponse.get("reply");
		}
	}
	catch (e)
	{
		info "iStore assistant backend call failed: " + e;
	}

	response.put("action","reply");
	response.put("replies",{reply});
	return response;
}

// Fallback greeting for anything that isn't a chat/message operation
response.put("action","reply");
response.put("replies",{"Hi! I'm the Chennai Math iStore assistant. How can I help you today?"});
return response;
